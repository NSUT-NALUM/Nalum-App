// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "./generated"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext, postgis, pg_trgm]
}

enum UserRole {
  STUDENT
  ALUMNI
  ADMIN
  PROFESSOR
  VISITOR
}

enum Campus {
  MAIN
  EAST
  WEST
}

enum Branch {
  CSE
  ECE
  MECH
  CIVIL
  CHEMICAL
  BIOTECH
  ELECTRICAL
  INSTRUMENTATION
  AEROSPACE
  MATERIALS
  INDUSTRIAL
  PRODUCTION
}

enum AlumniVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AlumniVerificationEventType {
  SUBMITTED
  APPROVED
  REJECTED
  REOPENED
  AUTO_RESUBMITTED
}

enum VerificationNotificationState {
  NOT_REQUIRED
  PENDING
  QUEUED
  SENT
  FAILED
}

enum EventStatus {
  PENDING
  PUBLISHED
  REJECTED
  CANCELLED
}

enum PostStatus {
  PENDING
  PUBLISHED
  REJECTED
  REMOVED
}

enum OpportunityStatus {
  PENDING
  PUBLISHED
  REJECTED
  REMOVED
}

enum OpportunityType {
  INTERNSHIP
  JOB
}

enum OpportunityWorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum VoteDirection {
  UP
  DOWN
}

enum ContentReportStatus {
  PENDING
  DISMISSED
  RESOLVED
}

enum ConversationType {
  DIRECT
  GROUP
}

enum ConversationParticipantRole {
	OWNER
	ADMIN
	MEMBER
}

enum MessageType {
	USER
	SYSTEM
}

enum ConnectionRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum GroupInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model User {
  id                       String                    @id @default(uuid(7)) @db.Uuid
  firstName                String
  lastName                 String
  email                    String                    @unique @db.Citext
  passwordHash             String?
  googleId                 String?                   @unique
  role                     UserRole
  emailVerified            Boolean                   @default(false)
  emailVerifiedAt          DateTime?
  verificationStatus       AlumniVerificationStatus?
  verificationSubmittedAt  DateTime?
  profileCompleted         Boolean                   @default(false)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  lastSeenAt               DateTime?
  // Relations
  profile                  Profile?
  socialMedia              SocialMedia?
  experiences              Experience[]
  bans                     UserBan[]                 @relation("UserBans")
  bansIssued               UserBan[]                 @relation("BansIssuedByAdmin")
  bansRevoked              UserBan[]                 @relation("BansRevokedByAdmin")
  verificationEvents       AlumniVerificationEvent[] @relation("VerificationSubject")
  verificationActions      AlumniVerificationEvent[] @relation("VerificationActor")
  refreshTokens            RefreshToken[]
  emailOtps                EmailOtp[]
  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]                 @relation("MessageSender")
  uploadedMessageAttachments MessageAttachment[]     @relation("MessageAttachmentOwner")
	messageReactions         MessageReaction[]
	messageMentions          MessageMention[]
  sentConnectionRequests   ConnectionRequest[]       @relation("ConnectionRequestSender")
  receivedConnectionRequests ConnectionRequest[]     @relation("ConnectionRequestRecipient")
	groupInvitationsSent     GroupInvitation[]         @relation("GroupInvitationSender")
	groupInvitationsReceived GroupInvitation[]         @relation("GroupInvitationRecipient")
  authoredEvents           Event[]                   @relation("EventAuthor")
  reviewedEvents           Event[]                   @relation("EventReviewer")
  eventRegistrations       EventRegistration[]
  authoredPosts          Post[]          @relation("PostAuthor")
  reviewedPosts          Post[]          @relation("PostReviewer")
  authoredOpportunities  Opportunity[]   @relation("OpportunityAuthor")
  reviewedOpportunities  Opportunity[]   @relation("OpportunityReviewer")
  authoredComments       Comment[]       @relation("CommentAuthor")
  removedComments        Comment[]       @relation("CommentRemover")
  postVotes              PostVote[]
  commentVotes           CommentVote[]
  contentReports         ContentReport[] @relation("ContentReportReporter")
  reviewedContentReports ContentReport[] @relation("ContentReportReviewer")

  @@index([firstName])
  @@index([lastName])
  @@index([role, verificationStatus, verificationSubmittedAt])
}

model ConnectionRequest {
  id          String                  @id @default(uuid(7)) @db.Uuid
  pairKey     String                  @unique
  requesterId String                  @db.Uuid
  recipientId String                  @db.Uuid
  text        String
  status      ConnectionRequestStatus @default(PENDING)
  respondedAt DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  requester   User                    @relation("ConnectionRequestSender", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient   User                    @relation("ConnectionRequestRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, status, updatedAt])
  @@index([requesterId, status, updatedAt])
}

model Conversation {
  id            String                    @id @default(uuid(7)) @db.Uuid
  type          ConversationType
  name          String?
  directPairKey String?                   @unique
  lastMessageAt DateTime                  @default(now())
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  participants  ConversationParticipant[]
  messages      Message[]
	attachments   MessageAttachment[]
	groupInvitations GroupInvitation[]

  @@index([lastMessageAt, id])
}

model ConversationParticipant {
  conversationId String                      @db.Uuid
  userId         String                      @db.Uuid
  role           ConversationParticipantRole @default(MEMBER)
  joinedAt       DateTime                    @default(now())
  leftAt         DateTime?
  lastReadMessageId String?                  @db.Uuid
  lastReadAt     DateTime?
  conversation   Conversation                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, leftAt, joinedAt])
}

model GroupInvitation {
  id             String                @id @default(uuid(7)) @db.Uuid
  conversationId String                @db.Uuid
  inviterId      String                @db.Uuid
  inviteeId      String                @db.Uuid
  status         GroupInvitationStatus @default(PENDING)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  conversation   Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  inviter        User                  @relation("GroupInvitationSender", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee        User                  @relation("GroupInvitationRecipient", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([conversationId, inviteeId])
  @@index([inviteeId, status, updatedAt])
}

model Message {
  id              String       @id @default(uuid(7)) @db.Uuid
  conversationId  String       @db.Uuid
  senderId        String       @db.Uuid
  clientMessageId String
  text            String
  type            MessageType  @default(USER)
  replyToId       String?      @db.Uuid
  replyPreview    String?
  replySenderId   String?      @db.Uuid
  editedAt        DateTime?
  deletedAt       DateTime?
  mentionsEveryone Boolean     @default(false)
  createdAt       DateTime     @default(now())
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  replyTo         Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         Message[]    @relation("MessageReplies")
  attachments     MessageAttachment[]
  reactions       MessageReaction[]
  mentions        MessageMention[]

  @@unique([conversationId, senderId, clientMessageId])
  @@index([conversationId, createdAt, id])
  @@index([replyToId])
}

model MessageAttachment {
  id             String       @id @default(uuid(7)) @db.Uuid
  conversationId String       @db.Uuid
  ownerId        String       @db.Uuid
  messageId      String?      @db.Uuid
  key            String       @unique
  contentType    String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  owner          User         @relation("MessageAttachmentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  message        Message?     @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([conversationId, ownerId, messageId])
}

model MessageReaction {
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
  @@index([messageId, emoji])
}

model MessageMention {
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId, createdAt])
}

model RefreshToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  deviceId   String    @default("legacy")
  deviceName String?
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, deviceId])
  @@index([expiresAt, revokedAt])
}

model EmailOtp {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  otpHash    String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, expiresAt])
}

model Profile {
  userId         String                                 @id @db.Uuid
  rollNumber     String?
  batch          Int
  branch         Branch
  campus         Campus
  phoneNumber    String?
  alternateEmail String?                                @db.Citext
  city           String?
  country        String?
  latitude       Float?
  longitude      Float?
  location       Unsupported("geography(Point, 4326)")?
  currentCompany String?
  currentRole    String?
  profilePicture String?
  createdAt      DateTime                               @default(now())
  updatedAt      DateTime                               @updatedAt
  user           User                                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([campus, batch])
  @@index([rollNumber])
  @@index([currentCompany])
}

model AlumniVerificationEvent {
  id                   String                        @id @default(uuid(7)) @db.Uuid
  userId               String                        @db.Uuid
  actorId              String?                       @db.Uuid
  type                 AlumniVerificationEventType
  previousStatus       AlumniVerificationStatus?
  newStatus            AlumniVerificationStatus
  reason               String?
  notificationState    VerificationNotificationState @default(NOT_REQUIRED)
  notificationError    String?
  notificationQueuedAt DateTime?
  notificationSentAt   DateTime?
  createdAt            DateTime                      @default(now())
  user                 User                          @relation("VerificationSubject", fields: [userId], references: [id], onDelete: Cascade)
  actor                User?                         @relation("VerificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([notificationState, type, createdAt])
  @@index([actorId])
}

model SocialMedia {
  userId   String  @id @db.Uuid
  linkedin String?
  github   String?
  twitter  String?
  website  String?
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Experience {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  company   String
  role      String
  startDate DateTime?
  endDate   DateTime?
  isCurrent Boolean   @default(false)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserBan {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @db.Uuid
  reason      String
  startsAt    DateTime  @default(now())
  expiresAt   DateTime?
  revokedAt   DateTime?
  revokedById String?   @db.Uuid
  bannedById  String?   @db.Uuid
  user        User      @relation("UserBans", fields: [userId], references: [id], onDelete: Cascade)
  bannedBy    User?     @relation("BansIssuedByAdmin", fields: [bannedById], references: [id], onDelete: SetNull)
  revokedBy   User?     @relation("BansRevokedByAdmin", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt, revokedAt])
  @@index([bannedById])
  @@index([revokedById])
}

model Event {
  id              String              @id @default(uuid(7)) @db.Uuid
  title           String
  description     String
  startsAt        DateTime
  endsAt          DateTime
  venue           String
  meetUrl         String?
  imageKeys       String[]
  status          EventStatus         @default(PENDING)
  authorId        String              @db.Uuid
  reviewerId      String?             @db.Uuid
  moderationNote  String?
  rejectionReason String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  author          User                @relation("EventAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reviewer        User?               @relation("EventReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  registrations   EventRegistration[]

  @@index([status, startsAt])
  @@index([authorId, createdAt])
  @@index([reviewerId])
}

model EventRegistration {
  eventId   String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId, createdAt])
}

model Post {
  id              String               @id @default(uuid(7)) @db.Uuid
  title           String
  body            String
  imageKeys       String[]
  status          PostStatus           @default(PENDING)
  authorId        String               @db.Uuid
  reviewerId      String?              @db.Uuid
  moderationNote  String?
  rejectionReason String?
  removedAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  author          User                 @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reviewer        User?                @relation("PostReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  comments        Comment[]
  votes           PostVote[]
  reports         ContentReport[]

  @@index([status, createdAt])
  @@index([authorId, status, createdAt])
  @@index([reviewerId])
}

model Opportunity {
  id              String               @id @default(uuid(7)) @db.Uuid
  roleTitle       String
  organization    String
  description     String
  type            OpportunityType
  workMode        OpportunityWorkMode
  location        String
  deadline        DateTime
  applicationUrl  String
  status          OpportunityStatus    @default(PENDING)
  authorId        String               @db.Uuid
  reviewerId      String?              @db.Uuid
  moderationNote  String?
  rejectionReason String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  author          User                 @relation("OpportunityAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reviewer        User?                @relation("OpportunityReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, deadline])
  @@index([authorId, status, createdAt])
  @@index([reviewerId])
}

model Comment {
  id          String                  @id @default(uuid(7)) @db.Uuid
  postId      String                  @db.Uuid
  parentId    String?                 @db.Uuid
  authorId    String                  @db.Uuid
  body        String
  editedAt    DateTime?
  removedAt   DateTime?
  removedById String?                 @db.Uuid
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  post        Post                    @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent      Comment?                @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies     Comment[]               @relation("CommentReplies")
  author      User                    @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  removedBy   User?                   @relation("CommentRemover", fields: [removedById], references: [id], onDelete: SetNull)
  votes       CommentVote[]
  reports     ContentReport[]

  @@index([postId, parentId, createdAt])
  @@index([authorId, createdAt])
  @@index([removedById])
}

model PostVote {
  postId    String                  @db.Uuid
  userId    String                  @db.Uuid
  direction VoteDirection
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  post      Post                    @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([postId, direction])
}

model CommentVote {
  commentId String                  @db.Uuid
  userId    String                  @db.Uuid
  direction VoteDirection
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  comment   Comment                 @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([commentId, direction])
}

model ContentReport {
  id           String                @id @default(uuid(7)) @db.Uuid
  postId       String?               @db.Uuid
  commentId    String?               @db.Uuid
  reporterId   String                @db.Uuid
  reason       String
  status       ContentReportStatus   @default(PENDING)
  reviewerId   String?               @db.Uuid
  reviewedAt   DateTime?
  createdAt    DateTime              @default(now())
  post         Post?                 @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment      Comment?              @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter     User                  @relation("ContentReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewer     User?                 @relation("ContentReportReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([postId, status])
  @@index([commentId, status])
  @@index([reporterId, createdAt])
  @@index([reviewerId])
}
